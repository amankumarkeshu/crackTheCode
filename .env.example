# Interview Questions Scraper Configuration
CRON_SECRET_TOKEN=your-secure-random-token-here

# Optional: Configure scraping sources
SCRAPER_ENABLE_LEETCODE=true
SCRAPER_ENABLE_GEEKSFORGEEKS=true
SCRAPER_ENABLE_GLASSDOOR=true
SCRAPER_ENABLE_INTERVIEWBIT=true

# Scraping limits
SCRAPER_MAX_QUESTIONS_PER_SOURCE=25
SCRAPER_RATE_LIMIT_MS=2000
SCRAPER_CACHE_DURATION_HOURS=6

# Company-specific scraper configuration
SCRAPER_MAX_QUESTIONS_HIGH_PRIORITY=15
SCRAPER_MAX_QUESTIONS_MEDIUM_PRIORITY=10
SCRAPER_MAX_QUESTIONS_LOW_PRIORITY=8

# Optional: Webhook for notifications
SCRAPER_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-url
SCRAPER_NOTIFY_ON_SUCCESS=false
SCRAPER_NOTIFY_ON_ERROR=true

# Deployment URL (for API calls in CLI/workflows)
VERCEL_URL=https://your-domain.vercel.app
API_URL=http://localhost:3000

# Frontend configuration (for admin panel)
NEXT_PUBLIC_CRON_SECRET_TOKEN=your-secure-random-token-here